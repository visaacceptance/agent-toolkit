{
  "name": "@visaacceptance/agent-toolkit",
  "version": "0.1.1",
  "description": "This toolkit provides a TypeScript implementation for interacting with Visa Acceptance APIs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./modelcontextprotocol": {
      "types": "./dist/modelcontextprotocol/index.d.ts",
      "default": "./dist/modelcontextprotocol/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    }
  },
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "dev": "ts-node-dev --respawn src/index.ts",
    "lint": "eslint . --ext .ts",
    "prepare": "npm run build",
    "test": "jest src/test/unit",
    "test:unit": "jest src/test/unit",
    "test:integration": "jest src/test/integration",
    "link": "npm link"
  },
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "ai": "^5.0.59",
    "axios": "^1.12.2",
    "cybersource-rest-client": "^0.0.71",
    "dotenv": "^16.5.0",
    "openai": "^5.19.1",
    "superagent": "^10.2.3",
    "zod": "^3.24.3"
  },
  "overrides": {
    "axios": "^1.12.2"
  }
}
